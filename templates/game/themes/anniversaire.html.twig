{# ==========================================================================
   THÈME "ANNIVERSAIRE" — tout le jeu dans ce fichier
   ==========================================================================
   9 écrans, dans l'ordre. Chacun est une <section class="theme-preview-screen">
   avec un data-screen unique (repris par le CSS pour déclencher ses
   animations, et par le JS du thème pour savoir quel écran est actif). #}

{# ---- Page 1 : Présentation du thème (pour nous, pas un écran du jeu) ---- #}
<section class="theme-preview-screen is-active" data-screen="presentation" data-preview-only="true">
    <div class="birthday-page-content">
        <div class="birthday-logo">BLIND TEST</div>
        <div class="birthday-title">BIRTHDAY GLOW</div>
        <div class="birthday-cake">🎂</div>
        <div class="birthday-timer" data-game-value="duration">15</div>
        <div class="birthday-subtitle">SPECIAL BIRTHDAY EDITION</div>
    </div>
</section>

{# ---- Page 2 : Accueil ---- #}
<section class="theme-preview-screen" data-screen="welcome">
    <div class="birthday-page-2">
        <div class="birthday-page-2-label">BLIND TEST</div>

        <h1 class="birthday-page-2-title" data-game-value="blindtest-name">BIRTHDAY GLOW</h1>

        <div class="birthday-page-2-cake">🎂</div>

        <div class="birthday-page-2-subtitle">
            UNE ÉDITION SPÉCIALE POUR UNE SOIRÉE SPÉCIALE
        </div>
    </div>
</section>

{# ---- Page : Description (seulement si le blind test en a une — sinon
   écran sauté dans le vrai jeu, voir assets/js/game/screens.js. Toujours
   visible en prévisualisation avec un texte d'exemple.) ---- #}
<section class="theme-preview-screen" data-screen="description">
    <div class="birthday-page-description">
        <div class="birthday-page-description-label">À propos de cette soirée</div>
        <p class="birthday-page-description-text" data-game-value="description">Exemple : une soirée toute en lumières et en confettis — ce texte reprend la description du blind test quand elle est renseignée.</p>
    </div>
</section>

{# ---- Page 3 : Règles du jeu ---- #}
{# data-screen-duration : surcharge la durée par défaut de cet écran
   (voir DEFAULT_SCREEN_DURATIONS dans assets/js/game/state.js), ICI
   SEULEMENT, pour laisser le temps aux voix synchronisées (voir
   playRulesVoiceSequence dans anniversaire.js) de toutes se terminer
   avant de passer à l'écran suivant. Les autres thèmes ne sont pas
   concernés, ils gardent la durée par défaut. #}
<section class="theme-preview-screen" data-screen="rules" data-screen-duration="11500">
    <div class="birthday-rules-page">
        <div class="birthday-rules-card">
            <div class="birthday-rules-decoration one"></div>
            <div class="birthday-rules-decoration two"></div>
            <div class="birthday-rules-decoration three"></div>
            <div class="birthday-rules-decoration four"></div>

            <h1 class="birthday-rules-title">RÈGLES DU JEU</h1>
            <div class="birthday-rules-title-line"></div>

            <ul class="birthday-rules-list">
                <li class="birthday-rule">
                    <span class="birthday-rule-number">
                        {{ inline_svg('images/icones/rule-balloon.svg') }}
                        <span class="birthday-rule-number-text">1</span>
                    </span>
                    <span><strong data-game-value="question-count">9</strong> chansons</span>
                </li>
                <li class="birthday-rule">
                    <span class="birthday-rule-number">
                        {{ inline_svg('images/icones/rule-balloon.svg') }}
                        <span class="birthday-rule-number-text">2</span>
                    </span>
                    <span><strong data-game-value="duration">15</strong> secondes par extrait</span>
                </li>
                <li class="birthday-rule" data-rules-point="title">
                    <span class="birthday-rule-number">
                        {{ inline_svg('images/icones/rule-balloon.svg') }}
                        <span class="birthday-rule-number-text">3</span>
                    </span>
                    <span><strong>1 point</strong> pour le titre</span>
                </li>
                <li class="birthday-rule" data-rules-point="artist">
                    <span class="birthday-rule-number">
                        {{ inline_svg('images/icones/rule-balloon.svg') }}
                        <span class="birthday-rule-number-text">4</span>
                    </span>
                    <span><strong>1 point</strong> pour l'artiste</span>
                </li>
                <li class="birthday-rule" data-rules-point="year">
                    <span class="birthday-rule-number">
                        {{ inline_svg('images/icones/rule-balloon.svg') }}
                        <span class="birthday-rule-number-text">5</span>
                    </span>
                    <span><strong>1 point</strong> pour l'année</span>
                </li>
            </ul>
        </div>

        <span class="birthday-rule-spark s1"></span>
        <span class="birthday-rule-spark s2"></span>
        <span class="birthday-rule-spark s3"></span>
        <span class="birthday-rule-spark s4"></span>
        <span class="birthday-rule-spark s5"></span>
        <span class="birthday-rule-spark s6"></span>
    </div>
</section>

