{% extends 'base.html.twig' %}

{% block title %}{{ blindTest.name }} — Family Games{% endblock %}

{% block bodyClass %}game-fullscreen theme-{{ themeSlug }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/theme-preview.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/game.css') }}">
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'game', 'corner-logo', themeSlug]) }}
{% endblock %}

{% block body %}
    <div class="game-corner-logo" id="game-corner-logo">
        <img src="{{ asset('images/logo.svg') }}" alt="">
    </div>

    <main
        id="game"
        class="game"
        data-blindtest-name="{{ blindTest.name }}"
        data-description="{{ blindTest.description }}"
        data-question-count="{{ blindTest.questions|length }}"
        data-duration="{{ blindTest.duration }}"
        data-is-preview="{{ isPreview ? '1' : '0' }}"
        data-required-fields="{{ requiredFieldsJson }}"
    >
        <script type="application/json" id="game-tracks-data">{{ tracksJson|raw }}</script>

        <audio id="game-audio" preload="none"></audio>
        <audio id="game-voice-audio" preload="none"></audio>
        <div id="youtube-target" class="game-player__yt-target"></div>

        <div id="game-screens" class="theme-preview">
            {% include 'game/themes/' ~ themeSlug ~ '.html.twig' %}
        </div>

        <div class="theme-preview-nav game-admin-bar" id="game-admin-bar" hidden>
            <button type="button" class="theme-preview-nav__btn" id="game-prev-btn" aria-label="Précédent" title="Précédent">{{ inline_svg('images/icones/arrow-prev.svg') }}</button>
            <button type="button" class="theme-preview-nav__btn" id="game-pause-btn" aria-label="Lecture / Pause" title="Lecture / Pause">
                <svg id="game-pause-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button type="button" class="theme-preview-nav__btn" id="game-next-btn" aria-label="Avance" title="Avance">{{ inline_svg('images/icones/arrow-next.svg') }}</button>
            {% if isPreview %}
                <button type="button" class="theme-preview-nav__btn game-admin-bar__record" id="game-record-btn" aria-label="Enregistrer" title="Enregistrer">⏺</button>
            {% endif %}
        </div>

        {% if isPreview %}
            <button type="button" class="game-record-start-btn" id="game-record-start-btn" hidden>Commencer</button>
        {% endif %}
    </main>
{% endblock %}
